# ===== إعدادات Docker Compose (هذا الملف لا يُرفع إلى Git) =====
POSTGRES_PASSWORD=change-me-strong-password
JWT_SECRET_KEY=change-me-to-a-random-string-of-at-least-64-characters
APP_ENV=production
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
